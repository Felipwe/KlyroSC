# Optional override for the Discord Application ID used by Rich Presence.
# KlyroSC ships with its official application built in, so leave this empty
# unless you want your own identity (create one at
# https://discord.com/developers/applications and paste the ID here or in
# Settings → Discord inside the app).
KLYRO_DISCORD_CLIENT_ID=

# Set to 1 to open DevTools automatically in development.
KLYRO_DEVTOOLS=

# Internal: boots the app, captures UI screenshots into out/smoke and exits.
KLYRO_SMOKE=
