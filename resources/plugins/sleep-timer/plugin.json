{
  "id": "sleep-timer",
  "name": "Sleep Timer",
  "version": "1.0.0",
  "description": "Pauses the music after the time you pick. Great for falling asleep.",
  "descriptionPt": "Pausa a música depois do tempo que você escolher. Perfeito pra dormir ouvindo som.",
  "author": "KlyroSC",
  "main": "index.js",
  "apiVersion": 1,
  "enabledByDefault": false,
  "permissions": ["player", "notifications"],
  "settings": [
    {
      "key": "minutes",
      "type": "number",
      "label": "Minutes until pause",
      "labelPt": "Minutos até pausar",
      "default": 30,
      "min": 5,
      "max": 240
    },
    {
      "key": "armed",
      "type": "boolean",
      "label": "Timer armed",
      "labelPt": "Timer ligado",
      "description": "Disarms automatically after firing.",
      "descriptionPt": "Desliga sozinho depois de disparar.",
      "default": false
    }
  ]
}
